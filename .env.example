# Supabase publishable configuration (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets: set in Vercel Environment Variables
SUPABASE_SERVICE_ROLE_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Pixabay video search and download for the Library/Text video modes
PIXABAY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Maziao PAT stays on the server. Adding it selects Maziao by default.
MAZIAO_API_KEY=
MAZIAO_MODEL=vieten_speech
# Optional override: maziao or eleven. No automatic switch on provider errors.
STUDIO_VOICE_PROVIDER=
STUDIO_ENCRYPTION_KEY=
# Optional comma-separated ElevenLabs voices explicitly shared with all members
STUDIO_SHARED_VOICE_IDS=
