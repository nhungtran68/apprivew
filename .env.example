# Supabase publishable configuration (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets: set in Vercel Environment Variables
SUPABASE_SERVICE_ROLE_KEY=
# payOS merchant channel; server-only. Add Production and Preview on Vercel.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Pixabay video search and download for the Library/Text video modes
PIXABAY_API_KEY=
ELEVENLABS_API_KEY=
# The same key is used by /api/video/transcribe (Scribe v2); enable Speech to Text
# for restricted keys. Apply the video_transcription_credit migration before use.
ELEVENLABS_MODEL=eleven_flash_v2_5
# Maziao PAT stays on the server. Adding it selects Maziao by default.
MAZIAO_API_KEY=
MAZIAO_MODEL=vieten_speech
# SaydiVoice live key must stay on the server. Set provider override to saydi to use it.
SAYDI_API_KEY=
# Optional override: saydi, maziao or eleven. No automatic switch on provider errors.
STUDIO_VOICE_PROVIDER=
STUDIO_ENCRYPTION_KEY=
# Optional comma-separated ElevenLabs voices explicitly shared with all members
STUDIO_SHARED_VOICE_IDS=
